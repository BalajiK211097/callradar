# ── AWS credentials (required) ────────────────────────────────────────────────
# All other secrets (Anthropic, Deepgram, S3 bucket) are fetched automatically
# from AWS Parameter Store on startup using these credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ── Local dev only (optional) ─────────────────────────────────────────────────
# Set these directly to skip Parameter Store (useful without AWS credentials).
# When running via docker-compose, DATABASE_URL is overridden automatically.
# DEEPSEEK_API_KEY=...
# DEEPGRAM_API_KEY=...
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/callradar
# S3_BUCKET_NAME=callradar-prod
